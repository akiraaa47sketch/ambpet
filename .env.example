# Copie para .env (desenvolvimento) ou cadastre como variáveis de ambiente na
# hospedagem (produção). NUNCA faça commit de valores reais.
# Para gerar segredos: python scripts/gerar_env.py --producao

APP_ENV=production

# --- Banco (Supabase) ---
# Dica: python scripts/gerar_env.py --supabase https://<ref>.supabase.co preenche tudo.
# As chaves publishable/anon e service_role do Supabase NÃO são usadas por este sistema.
# Supabase > Project Settings > Database > Connection string.
# Use o usuário de menor privilégio criado pela migração (ambpet_app), não o "postgres".
# Pooler (sessão): postgresql://ambpet_app.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DB_SCHEMA=ambpet
# Certificado CA do Supabase (Database Settings > SSL Configuration) para sslmode=verify-full
DB_SSLROOTCERT=

# --- Segredos da aplicação ---
SECRET_KEY=
# Chaves AES-256 (32 bytes base64). Várias permitem rotação: v1:...,v2:...
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY=v1
# Chave HMAC dos índices de busca (diferente da de criptografia)
BLIND_INDEX_KEY=

# --- Segurança ---
EXIGIR_2FA=1
SESSAO_INATIVIDADE_MIN=30
SESSAO_MAX_HORAS=10
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MIN=15
# 1 se estiver atrás de proxy reverso (nginx, Render, Fly, etc.)
BEHIND_PROXY=1
USAR_VIACEP=1

# --- Clínica / LGPD ---
CLINICA_NOME=
CLINICA_ENDERECO=
CLINICA_TELEFONE=
CONTROLADOR_NOME=
CONTROLADOR_CNPJ=
ENCARREGADO_NOME=
ENCARREGADO_EMAIL=
AVISO_PRIVACIDADE_VERSAO=1.0
RETENCAO_PRONTUARIO_ANOS=5
AGENDA_INTERVALO_MIN=30
